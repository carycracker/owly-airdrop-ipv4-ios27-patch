+/// The service ID this receiver uses, kept across runs so a phone doesn't
+/// keep a dead `_airdrop._tcp` instance for every restart (local patch):
+/// `OWLY_SERVICE_ID` wins, then `$state/service-id`, else a fresh one is
+/// written there.
+fn stable_service_id(state: &Path) -> io::Result<String> {
+    if let Some(id) = std::env::var_os("OWLY_SERVICE_ID") {
+        let id = id.to_string_lossy().into_owned();
+        if is_service_id(&id) {
+            return Ok(id);
+        }
+        return Err(io::Error::other("OWLY_SERVICE_ID is not 12 hex digits"));
+    }
+    let path = state.join("service-id");
+    if let Ok(saved) = std::fs::read_to_string(&path) {
+        let saved = saved.trim().to_string();
+        if is_service_id(&saved) {
+            return Ok(saved);
+        }
+    }
+    let id = random_service_id()?;
+    std::fs::create_dir_all(state)?;
+    let _ = std::fs::write(&path, &id);
+    Ok(id)
+}
+
+fn is_service_id(s: &str) -> bool {
+    s.len() == 12 && s.bytes().all(|b| b.is_ascii_hexdigit())
